# Copy to .env.local and fill in. Nothing here is required to run the tests;
# an LLM key is required to run the app.

# --- Inference (need at least one) -----------------------------------------
# OpenRouter is the primary chain: free open-weight models, no card required.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional second provider. Different quota bucket, so it survives an
# OpenRouter rate limit. https://console.groq.com/keys
GROQ_API_KEY=

# Local Ollama needs no key — it is used automatically when it's running.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Override the model chain entirely: "provider:model,provider:model".
# Useful for pinning one model while iterating on a prompt, e.g.
#   LLM_MODELS=ollama:qwen3:8b
# LLM_MODELS=

# Local and self-hosted models are much slower than hosted ones at a long
# structured extraction. Default is 90s.
# LLM_TIMEOUT_MS=300000

# --- Storage ----------------------------------------------------------------
# Unset means an in-process store: fine for local dev, wrong on serverless,
# where an analysis written by one instance is a 404 on the next.
# Neon free tier: https://neon.tech
# DATABASE_URL=

# --- App --------------------------------------------------------------------
# Sent to OpenRouter for attribution only.
# PUBLIC_APP_URL=http://localhost:3000
